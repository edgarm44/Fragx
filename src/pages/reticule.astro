---
import Base from '../layouts/Base.astro';
import { COULEURS } from '../lib/reticule';

const PRESETS = [
  { nom: 'aspas', code: '0;P;h;0;0l;4;0o;0;0a;1;0f;0;1b;0' },
  { nom: 'TenZ', code: '0;s;1;P;c;5;o;0;f;0;0l;2;0v;2;0g;1;0o;1;0a;1;0f;0;1b;0' },
  { nom: 'Derke', code: '0;P;o;1;0t;1;0l;4;0o;2;0a;1;0f;0;1t;0;1l;1;1o;0;1a;1;1m;0;1f;0' },
  { nom: 'Boaster (point)', code: '0;s;1;P;c;1;o;1;d;1;0l;0;0o;2;0a;1;0f;0;1t;0;1l;0;1o;0;1a;0;S;c;1;o;1' },
  { nom: 'Par défaut', code: '0;P' },
];

type Curseur = { id: string; nom: string; min: number; max: number; pas: number };
const lignes = (pre: string, maxL: number, maxO: number): Curseur[] => [
  { id: `${pre}.opacite`, nom: 'Opacité', min: 0, max: 1, pas: 0.05 },
  { id: `${pre}.longueur`, nom: 'Longueur', min: 0, max: maxL, pas: 1 },
  { id: `${pre}.epaisseur`, nom: 'Épaisseur', min: 0, max: 10, pas: 1 },
  { id: `${pre}.ecart`, nom: 'Écart', min: 0, max: maxO, pas: 1 },
];
const GROUPES = [
  { titre: 'Contour', interrupteur: 'contour', curseurs: [
    { id: 'contourOpacite', nom: 'Opacité', min: 0, max: 1, pas: 0.05 },
    { id: 'contourEpaisseur', nom: 'Épaisseur', min: 1, max: 6, pas: 1 },
  ] },
  { titre: 'Point central', interrupteur: 'point', curseurs: [
    { id: 'pointOpacite', nom: 'Opacité', min: 0, max: 1, pas: 0.05 },
    { id: 'pointEpaisseur', nom: 'Épaisseur', min: 1, max: 6, pas: 1 },
  ] },
  { titre: 'Lignes intérieures', interrupteur: 'interne.afficher', curseurs: lignes('interne', 20, 20) },
  { titre: 'Lignes extérieures', interrupteur: 'externe.afficher', curseurs: lignes('externe', 10, 40) },
];
---
<Base title="Éditeur de réticule" description="Crée ton réticule Valorant avec un aperçu en direct sur plusieurs fonds, puis copie le code à importer dans le jeu.">
  <div class="conteneur en-tete-page">
    <h1>Éditeur de réticule</h1>
    <p class="chapo">
      Règle ton réticule Valorant, vérifie qu'il reste visible sur tous les fonds, puis copie le code.
      Dans le jeu : Paramètres, Réticule, icône d'import à côté du profil.
    </p>
  </div>

  <div class="conteneur disposition">
    <div class="colonne-apercu">
      <div class="apercu panneau">
        <canvas id="apercu" aria-label="Aperçu du réticule"></canvas>
        <div class="commandes-apercu">
          <div class="choix" role="radiogroup" aria-label="Fond">
            <button type="button" role="radio" aria-checked="true" data-fond="sombre">Sombre</button>
            <button type="button" role="radio" aria-checked="false" data-fond="clair">Clair</button>
            <button type="button" role="radio" aria-checked="false" data-fond="mixte">Mixte</button>
          </div>
          <div class="choix" role="radiogroup" aria-label="Zoom">
            <button type="button" role="radio" aria-checked="false" data-zoom="1">×1</button>
            <button type="button" role="radio" aria-checked="true" data-zoom="3">×3</button>
            <button type="button" role="radio" aria-checked="false" data-zoom="6">×6</button>
          </div>
        </div>
      </div>

      <section class="code" aria-labelledby="t-code">
        <h2 id="t-code">Code du réticule</h2>
        <div class="ligne-code">
          <input id="code" type="text" readonly aria-label="Code à importer dans Valorant" />
          <button class="bouton bouton-principal" type="button" id="copier">Copier</button>
        </div>
        <p class="statut" id="statut-copie" aria-live="polite"></p>
        <h3>Importer un code</h3>
        <div class="ligne-code">
          <input id="code-import" type="text" placeholder="0;P;c;5;h;0;0l;4;..." aria-label="Code à importer" />
          <button class="bouton bouton-secondaire" type="button" id="importer">Importer</button>
        </div>
        <p class="statut" id="statut-import" aria-live="polite"></p>
        <h3>Partir d'un réticule connu</h3>
        <div class="presets">
          {PRESETS.map((p) => <button type="button" class="preset" data-code={p.code}>{p.nom}</button>)}
        </div>
        <p class="note">
          Codes des pros relevés sur valorant-spind.de (septembre 2026). Les erreurs de mouvement et de tir ne sont pas
          animées dans l'aperçu ; vérifie toujours le rendu final dans le jeu.
        </p>
      </section>
    </div>

    <form class="reglages" id="reglages" novalidate>
      <fieldset>
        <legend>Couleur</legend>
        <div class="couleurs">
          {COULEURS.map((c, i) => (
            <label class="pastille" title={c.nom}>
              <input type="radio" name="couleur" value={i} checked={i === 0} />
              <span style={`background:${c.hex}`}></span>
              <span class="visuellement-cache">{c.nom}</span>
            </label>
          ))}
          <label class="pastille perso" title="Couleur personnalisée">
            <input type="radio" name="couleur" value="8" />
            <input type="color" id="perso" value="#ffffff" aria-label="Couleur personnalisée" />
          </label>
        </div>
      </fieldset>

      {GROUPES.map((g) => (
        <fieldset>
          <legend>
            <label class="interrupteur"><input type="checkbox" data-champ={g.interrupteur} /> {g.titre}</label>
          </legend>
          {g.curseurs.map((c) => (
            <div class="curseur">
              <label for={`c-${c.id}`}>{c.nom}</label>
              <input type="range" id={`c-${c.id}`} data-champ={c.id} min={c.min} max={c.max} step={c.pas} />
              <output for={`c-${c.id}`} class="chiffre"></output>
            </div>
          ))}
          {g.titre.startsWith('Lignes') && (
            <div class="cases">
              <label><input type="checkbox" data-champ={`${g.interrupteur.split('.')[0]}.mouvement`} /> Erreur de mouvement</label>
              <label><input type="checkbox" data-champ={`${g.interrupteur.split('.')[0]}.tir`} /> Erreur de tir</label>
            </div>
          )}
        </fieldset>
      ))}
      <label class="interrupteur"><input type="checkbox" data-champ="fondu" /> Estomper le réticule avec l'erreur de tir</label>
    </form>
  </div>
</Base>

<style>
  .disposition { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; align-items: start; padding-bottom: 2rem; }
  .colonne-apercu { position: sticky; top: 5.5rem; display: grid; gap: 1.5rem; }
  .apercu { padding: 1px; display: grid; }
  canvas { width: 100%; aspect-ratio: 16 / 9; display: block; image-rendering: pixelated; }
  .commandes-apercu { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.75rem; flex-wrap: wrap; }
  .choix { display: flex; gap: 0.4rem; }
  .choix button, .preset {
    font: 600 var(--t-s)/1 var(--titre); color: var(--gris); background: var(--plaque);
    border: 1px solid var(--trait); border-radius: var(--rayon); padding: 0.5rem 0.8rem; cursor: pointer;
  }
  .choix button[aria-checked='true'] { color: var(--texte); border-color: var(--magenta); }
  .preset:hover, .choix button:hover { color: var(--texte); border-color: var(--violet); }
  .code h2 { font-size: var(--t-xl); font-style: italic; }
  .code h3 { font-size: var(--t-m); margin: 1.25rem 0 0.5rem; }
  .ligne-code { display: flex; gap: 1rem; align-items: center; }
  .ligne-code input { font-family: ui-monospace, monospace; font-size: var(--t-s); }
  .statut { min-height: 1.4em; margin: 0.4rem 0 0; font-size: var(--t-s); color: var(--ok); }
  .statut[data-erreur] { color: var(--alerte); }
  .presets { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .note { color: var(--gris); font-size: var(--t-xs); margin-top: 1rem; }

  .reglages { display: grid; gap: 1rem; }
  fieldset { border: 1px solid var(--trait); background: rgb(18 11 46 / 0.85); padding: 0.85rem 1rem 1rem; margin: 0; }
  legend { font-family: var(--titre); font-weight: 700; padding: 0 0.35rem; }
  .interrupteur { display: inline-flex; gap: 0.5rem; align-items: center; margin: 0; cursor: pointer; font-family: var(--titre); font-weight: 700; }
  .interrupteur input, .cases input { width: auto; accent-color: var(--magenta); }
  .couleurs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pastille { position: relative; margin: 0; cursor: pointer; }
  .pastille input[type='radio'] { position: absolute; opacity: 0; inset: 0; }
  .pastille span:first-of-type, .pastille input[type='color'] {
    display: block; width: 2.1rem; height: 2.1rem; border-radius: var(--rayon); border: 2px solid var(--trait);
  }
  .pastille input[type='color'] { padding: 0; background: none; cursor: pointer; }
  .pastille input[type='radio']:checked + span, .pastille input[type='radio']:checked + input[type='color'] { border-color: var(--cyan); box-shadow: var(--lueur-cyan); }
  .pastille input[type='radio']:focus-visible + span { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .curseur { display: grid; grid-template-columns: 6rem 1fr 3rem; gap: 0.75rem; align-items: center; margin-top: 0.6rem; }
  .curseur label { margin: 0; font-weight: 400; color: var(--gris); }
  .curseur input { padding: 0; accent-color: var(--magenta); border: 0; background: none; box-shadow: none; }
  .curseur output { text-align: right; }
  fieldset[data-off] .curseur, fieldset[data-off] .cases { opacity: 0.4; }
  .cases { display: flex; gap: 1.25rem; margin-top: 0.75rem; flex-wrap: wrap; }
  .cases label { display: flex; gap: 0.4rem; align-items: center; margin: 0; font-weight: 400; color: var(--gris); }
  @media (max-width: 56rem) {
    .disposition { grid-template-columns: 1fr; }
    .colonne-apercu { position: static; }
  }
</style>

<script>
  import { lire, ecrire, dessiner, copier, DEFAUT, type Reticule } from '../lib/reticule';

  const CLE = 'fragx.reticule';
  let general: string[] = [];
  let reste: string[] = [];
  let r: Reticule = copier(DEFAUT);
  try {
    const memo = localStorage.getItem(CLE);
    if (memo) ({ general, principal: r, reste } = lire(memo));
  } catch { /* indisponible */ }

  const form = document.getElementById('reglages') as HTMLFormElement;
  const champCode = document.getElementById('code') as HTMLInputElement;
  const perso = document.getElementById('perso') as HTMLInputElement;
  const canvas = document.getElementById('apercu') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let fond = 'sombre';
  let zoom = 3;

  const obtenir = (chemin: string): unknown => chemin.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], r);
  const definir = (chemin: string, v: unknown) => {
    const k = chemin.split('.');
    const parent = k.slice(0, -1).reduce<Record<string, unknown>>((o, x) => o[x] as Record<string, unknown>, r as unknown as Record<string, unknown>);
    parent[k[k.length - 1]] = v;
  };

  function versFormulaire() {
    for (const el of form.querySelectorAll<HTMLInputElement>('[data-champ]')) {
      const v = obtenir(el.dataset.champ!);
      if (el.type === 'checkbox') el.checked = Boolean(v);
      else el.value = String(v);
    }
    const radio = form.querySelector<HTMLInputElement>(`input[name="couleur"][value="${r.couleur}"]`);
    if (radio) radio.checked = true;
    perso.value = `#${r.perso.slice(0, 6).toLowerCase()}`;
    majAffichage();
  }

  function majAffichage() {
    for (const el of form.querySelectorAll<HTMLInputElement>('input[type="range"]')) {
      const out = el.parentElement!.querySelector('output')!;
      const n = Number(el.value);
      out.textContent = Number(el.step) < 1 ? n.toFixed(2).replace('.', ',') : String(n);
    }
    for (const fs of form.querySelectorAll('fieldset')) {
      const inter = fs.querySelector<HTMLInputElement>('legend input[type="checkbox"]');
      if (inter) fs.toggleAttribute('data-off', !inter.checked);
    }
    const code = ecrire(r, general, reste);
    champCode.value = code;
    try { localStorage.setItem(CLE, code); } catch { /* indisponible */ }
    rendre();
  }

  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'couleur') r.couleur = Number(el.value);
    else if (el === perso) { r.perso = perso.value.slice(1).toUpperCase(); r.couleur = 8; form.querySelector<HTMLInputElement>('input[name="couleur"][value="8"]')!.checked = true; }
    else if (el.dataset.champ) definir(el.dataset.champ, el.type === 'checkbox' ? el.checked : Number(el.value));
    if (el.dataset.champ?.endsWith('.longueur')) definir(el.dataset.champ.replace('longueur', 'longueurV'), Number(el.value));
    majAffichage();
  });
  form.addEventListener('submit', (e) => e.preventDefault());

  // --- Aperçu ------------------------------------------------------------
  function dessinerFond(L: number, H: number) {
    if (fond === 'clair') {
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, '#cfe8ff'); g.addColorStop(0.6, '#f4efe2'); g.addColorStop(1, '#d9cdb4');
      ctx.fillStyle = g; ctx.fillRect(0, 0, L, H);
      ctx.fillStyle = '#e9e2d0'; ctx.fillRect(L * 0.1, H * 0.35, L * 0.35, H * 0.65);
      ctx.fillStyle = '#c9bc9e'; ctx.fillRect(L * 0.6, H * 0.25, L * 0.3, H * 0.75);
    } else if (fond === 'mixte') {
      const g = ctx.createLinearGradient(0, 0, L, 0);
      g.addColorStop(0, '#2b2f3a'); g.addColorStop(0.5, '#8a7f6a'); g.addColorStop(1, '#e8e1cf');
      ctx.fillStyle = g; ctx.fillRect(0, 0, L, H);
      ctx.fillStyle = '#3d6b4a'; ctx.fillRect(L * 0.4, H * 0.45, L * 0.2, H * 0.55);
      ctx.fillStyle = '#b8402f'; ctx.fillRect(L * 0.46, H * 0.4, L * 0.08, H * 0.2);
    } else {
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, '#1b1d27'); g.addColorStop(1, '#0c0d12');
      ctx.fillStyle = g; ctx.fillRect(0, 0, L, H);
      ctx.fillStyle = '#262a36'; ctx.fillRect(L * 0.08, H * 0.3, L * 0.3, H * 0.7);
      ctx.fillStyle = '#313646'; ctx.fillRect(L * 0.62, H * 0.2, L * 0.3, H * 0.8);
    }
  }
  function rendre() {
    const dpr = window.devicePixelRatio || 1;
    const L = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = Math.round(L * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.imageSmoothingEnabled = false;
    dessinerFond(L, H);
    // Le réticule est dessiné à sa taille réelle sur un écran 1080p, multipliée par le zoom
    dessiner(ctx, r, L / 2, H / 2, zoom);
  }
  window.addEventListener('resize', rendre);

  for (const groupe of ['fond', 'zoom']) {
    for (const b of document.querySelectorAll<HTMLButtonElement>(`[data-${groupe}]`)) {
      b.addEventListener('click', () => {
        for (const o of document.querySelectorAll(`[data-${groupe}]`)) o.setAttribute('aria-checked', String(o === b));
        if (groupe === 'fond') fond = b.dataset.fond!; else zoom = Number(b.dataset.zoom);
        rendre();
      });
    }
  }

  // --- Copier / importer ---------------------------------------------------
  const statutCopie = document.getElementById('statut-copie')!;
  const statutImport = document.getElementById('statut-import')!;
  document.getElementById('copier')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(champCode.value);
      statutCopie.textContent = 'Code copié. Colle-le dans Valorant : Paramètres, Réticule, Importer.';
    } catch {
      champCode.select();
      statutCopie.textContent = 'Copie automatique impossible : le code est sélectionné, fais Ctrl+C.';
    }
  });

  function importer(code: string) {
    const c = code.trim();
    if (!/^[01];/.test(c) && c !== '0') {
      statutImport.dataset.erreur = '';
      statutImport.textContent = 'Ce texte ne ressemble pas à un code de réticule Valorant (il doit commencer par 0;).';
      return;
    }
    ({ general, principal: r, reste } = lire(c));
    delete statutImport.dataset.erreur;
    statutImport.textContent = 'Réticule importé.';
    versFormulaire();
  }
  document.getElementById('importer')!.addEventListener('click', () => importer((document.getElementById('code-import') as HTMLInputElement).value));
  for (const b of document.querySelectorAll<HTMLButtonElement>('.preset')) {
    b.addEventListener('click', () => { importer(b.dataset.code!); statutImport.textContent = `Réticule « ${b.textContent} » chargé.`; });
  }

  versFormulaire();
</script>
